  :root { color-scheme: light dark; --bg:#fff; --fg:#1b1f24; --muted:#5a6472; --surface:#f3f5f8; --border:#d7dde5; }
  @media (prefers-color-scheme: dark) {
    :root { --bg:#181a1f; --fg:#eef1f6; --muted:#9aa3b2; --surface:#22252b; --border:#333a45; }
  }
  body { background:var(--bg); color:var(--fg); font:16px/1.6 system-ui,sans-serif; margin:0 auto; max-width:46rem; padding:3rem 1.25rem; }
  h1 { font-size:1.6rem; margin:0 0 .25rem; }
  p.lead { color:var(--muted); margin:0 0 2rem; }
  pre { background:var(--surface); border:1px solid var(--border); border-radius:8px; padding:1rem; overflow-x:auto; }
