[Desktop Entry]
Type=Application
Name=Intel NPU Speech to Text
Comment=Private local Whisper transcription on Intel AI Boost
Exec=@HOME@/.local/bin/intel-npu-speech
Icon=audio-input-microphone
Terminal=false
Categories=Utility;Accessibility;
Keywords=Intel;NPU;OpenVINO;speech;transcription;
# X-KDE-Shortcuts is declarative only. KDE honours it for applications installed
# system-wide, but ignores it for a desktop file in ~/.local/share/applications,
# so install.sh registers the shortcut in kglobalshortcutsrc directly.
X-KDE-Shortcuts=Meta+Alt+S
