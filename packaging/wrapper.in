#!/bin/bash
# Wrapper installed as /usr/bin/@COMMAND@ by the distribution packages.
#
# The real program lives in a per-user virtual environment rather than in
# system site-packages, because its inference stack is not packaged by any
# distribution and its models belong to the user rather than to the system. If
# that environment is missing the user gets a sentence telling them what to
# run, which is the whole reason this is a wrapper and not a symlink.
set -euo pipefail

DATA_DIR="${INTEL_NPU_TOOLS_HOME:-}"
if [[ -z "$DATA_DIR" ]]; then
  # An installation predating the rename keeps its environment under the old
  # directory name; use whichever is actually there.
  DATA_DIR="$HOME/.local/share/intel-npu-tools"
  if [[ ! -e "$DATA_DIR" && -e "$HOME/.local/share/intel-arrow-lake-npu-tools" ]]; then
    DATA_DIR="$HOME/.local/share/intel-arrow-lake-npu-tools"
  fi
fi
PROGRAM="$DATA_DIR/venv/bin/@COMMAND@"

if [[ ! -x "$PROGRAM" ]]; then
  message="Intel NPU Tools is installed but not yet set up for this user.
Run: intel-npu-tools-setup"

  # Always say it on stderr. An earlier version only did so when stderr was a
  # terminal and otherwise opened a dialog, which meant that piping the output
  # of a command — entirely normal in a script — popped a window on the user's
  # desktop and printed nothing at all.
  echo "$message" >&2

  # A launch from a desktop menu has nowhere to print, so additionally show a
  # dialog when there is a display and no terminal on either stream. Failure to
  # do so is ignored: the message has already been delivered.
  if [[ ! -t 1 && ! -t 2 && ( -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ) ]]; then
    if command -v kdialog >/dev/null; then
      kdialog --error "$message" >/dev/null 2>&1 || true
    elif command -v zenity >/dev/null; then
      zenity --error --no-wrap --text="$message" >/dev/null 2>&1 || true
    fi
  fi
  exit 1
fi

exec "$PROGRAM" "$@"
