[Desktop Entry]
Type=Application
Name=Intel NPU Screenshot OCR
Comment=Extract screen text using Intel AI Boost
Exec=@BINDIR@/intel-npu-ocr
Icon=intel-npu-tools
Terminal=false
Categories=Utility;Accessibility;
Keywords=Intel;NPU;OpenVINO;OCR;screenshot;
# X-KDE-Shortcuts is declarative only. KDE honours it for applications installed
# system-wide, but ignores it for a desktop file in ~/.local/share/applications,
# so install.sh registers the shortcut in kglobalshortcutsrc directly.
X-KDE-Shortcuts=Meta+Alt+O
