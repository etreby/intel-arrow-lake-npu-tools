# Build Intel's NPU userspace driver from source on Fedora.
#
# Expensive: it clones OpenVINO and LLVM and runs to roughly 7,500 compilation
# steps, the better part of an hour on 24 cores.
#
# The first attempt stopped at about 5,900 steps with -Werror=maybe-uninitialized
# raised inside LLVM's own DenseMap.h — a GCC 14 false positive, in code Intel
# does not maintain, made fatal by the -Werror that cmake/compiler_flags.cmake
# sets. The compiler wrapper below is the fix, and it is verified in isolation:
# the same construct that GCC rejects compiles through the wrapper. Whether the
# whole build now completes has not been confirmed end to end, because the
# network here has been dropping connections to GitHub and the clone is large.
#
# Dockerfile.fedora next to this file takes the shorter route and *is* verified
# working, on the hardware: Fedora's own Level Zero loader plus Intel's
# binaries unpacked from their .deb, running a model on the NPU. If all you
# want is the NPU on an RPM distribution, use that. This file matters if you
# want to build the driver rather than redistribute Intel's build of it —
# which is what packaging it for a distribution would require.
#
# It exists to answer one question: can an RPM distribution run the NPU at all,
# given that Intel publishes the driver only as .deb for Ubuntu 24.04?
#
# Only two of the three pieces have to be built. The firmware is already
# solved — /lib/firmware/intel/vpu belongs to linux-firmware, which Fedora,
# openSUSE and Arch all ship, so nobody needs to redistribute Intel firmware.
# The Level Zero loader is packaged as oneapi-level-zero. What is missing on
# every RPM distribution is the user-mode driver and the NPU compiler, and
# those are MIT licensed, so building and redistributing them is allowed.
#
# Built at a pinned tag rather than a branch, because the thing it has to stay
# compatible with is the host's kernel driver.
FROM fedora:41

ARG NPU_DRIVER_TAG=v1.35.0

# The driver's own build dependencies.
# git-lfs is not optional and its absence is not obvious: building the NPU
# compiler makes CMake clone OpenVINO's own source tree during the build, and
# that tree stores files in LFS. Without it the clone dies with "the remote end
# hung up unexpectedly" several hundred build steps in.
RUN dnf install -y --setopt=install_weak_deps=False \
      git git-lfs cmake ninja-build gcc gcc-c++ make \
      oneapi-level-zero oneapi-level-zero-devel \
      python3 python3-pip python3-devel \
      libudev-devel pciutils \
    && dnf clean all

# Make -Werror non-fatal, by wrapping the compiler rather than by passing a
# flag. The code that fails is not Intel's: it is LLVM's DenseMap.h, compiled
# inside an ExternalProject that configures itself, so a -DCMAKE_CXX_FLAGS on
# the outer build does not necessarily reach it. A wrapper earlier in PATH
# reaches every invocation by construction. GCC takes the last warning option
# it is given, so appending -Wno-error defeats an earlier -Werror wherever
# that -Werror was set.
#
# This suppresses nothing real. The diagnostic is a known GCC 14 false
# positive about a DenseMap bucket pointer, in third-party code, and treating
# somebody else's warnings as fatal was never the packager's intent.
RUN set -eux; \
    for tool in gcc g++ cc c++; do \
      printf '#!/bin/sh\nexec /usr/bin/%s "$@" -Wno-error\n' "$tool" > "/usr/local/bin/$tool"; \
      chmod 755 "/usr/local/bin/$tool"; \
    done; \
    g++ --version | head -1; \
    command -v g++

# The source is fetched outside this build, by scripts/fetch-npu-driver-source.sh,
# and bind-mounted in. That is not a stylistic preference: a container build
# discards everything it has when a step fails, so on a connection that drops
# half its requests each attempt begins from nothing and the download never
# finishes — measured here across six attempts, none of which got the whole
# tree. A directory on the host keeps what it has won and can be resumed until
# it is complete, which took several passes.
#
# Copied rather than built in place, so the cache stays exactly as fetched.
#
#   ./scripts/fetch-npu-driver-source.sh
#   podman build -t intel-npu-driver:fedora \
#     -v ~/.cache/intel-npu-driver-src:/src/npu-driver-cache:ro \
#     -f packaging/docker/Dockerfile.fedora-driver .
RUN set -eux; \
    # Restored deliberately: these were lost when the clone loop was replaced
    # by the mounted cache, and without them a stalled transfer simply hangs.
    # The build then sits with several git processes making no progress and no
    # failure for the retry loop to act on — which is exactly what happened.
    # lowSpeedTime turns a transfer that has gone quiet into a prompt error,
    # and HTTP/1.1 stops one dropped connection taking every multiplexed fetch
    # with it. The nested clones below are all subject to both.
    git config --global http.version HTTP/1.1; \
    git config --global http.postBuffer 524288000; \
    git config --global http.lowSpeedLimit 1000; \
    git config --global http.lowSpeedTime 60; \
    test -d /src/npu-driver-cache || { \
      echo "Mount the driver source at /src/npu-driver-cache." >&2; \
      echo "Run scripts/fetch-npu-driver-source.sh first; it prints the command." >&2; \
      exit 1; \
    }; \
    mkdir -p /src; \
    cp -a /src/npu-driver-cache /src/npu-driver; \
    test -f /src/npu-driver/third_party/npu_compiler_elf/CMakeLists.txt || { \
      echo "The mounted source is incomplete; re-run the fetch script." >&2; exit 1; \
    }; \
    cmake -S /src/npu-driver -B /src/build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DENABLE_NPU_COMPILER_BUILD=ON \
      -DENABLE_COMPILATION_FLAGS_OVERRIDE=ON \
      -DENABLE_VALIDATION_BUILD=OFF; \
    # Retried generously, because the compiler is an ExternalProject that
    # clones OpenVINO, OpenCV, ONNX Runtime, oneTBB and a fork of LLVM as build
    # steps — several gigabytes — and CMake gives each exactly two attempts
    # before aborting everything. Those are the steps that fail on an
    # unreliable connection, and unlike the source tree they cannot be
    # pre-fetched without knowing more about ExternalProject than is wise.
    #
    # Retrying is worth doing because ninja stamps what it finished: every
    # compiled object survives, and a retry re-runs only the download that
    # failed. Progress therefore accumulates across attempts even though each
    # individual clone starts over.
    for attempt in $(seq 1 20); do \
      if cmake --build /src/build --parallel "$(nproc)"; then break; fi; \
      echo "build attempt $attempt failed; resuming"; \
      test "$attempt" -lt 20 || { echo "the driver build did not complete" >&2; exit 1; }; \
      sleep 30; \
    done; \
    cmake --install /src/build; \
    ldconfig; \
    rm -rf /src

# The toolkit, so the same three-step check can run here as against the
# Ubuntu image: open the device, find the NPU, run a model on it.
COPY pyproject.toml README.md LICENSE /app/
COPY src /app/src
RUN pip install --no-cache-dir /app

ENV INTEL_NPU_TOOLS_HOME=/models
RUN mkdir -p /models
VOLUME /models

ENTRYPOINT []
CMD ["intel-npu-mcp"]
