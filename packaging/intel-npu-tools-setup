#!/bin/bash
# Prepare a user's environment after the package is installed.
#
# The package deliberately contains no models and no inference stack. The
# models are roughly 800 MB and are redistributed under their own licences, and
# OpenVINO is not in the Debian, Fedora or Arch archives, so neither belongs in
# a system package. Downloading them from a maintainer script would also be
# wrong: package installation must not depend on the network, and it runs as
# root while these files belong to a user.
#
# So the package ships the code, and this creates the per-user environment.
# Running it twice is safe.
set -euo pipefail

LIBDIR="${INTEL_NPU_TOOLS_LIBDIR:-/usr/lib/intel-npu-tools}"
# The project was renamed; an existing installation keeps its data under the
# old directory name. Use whichever exists so a rename never orphans a
# gigabyte of models, and prefer the new name for a fresh install.
default_data_dir() {
  if [ -n "${INTEL_NPU_TOOLS_HOME:-}" ]; then
    printf '%s' "$INTEL_NPU_TOOLS_HOME"
    return
  fi
  if [ ! -e "$HOME/.local/share/intel-npu-tools" ] \
     && [ -e "$HOME/.local/share/intel-arrow-lake-npu-tools" ]; then
    printf '%s' "$HOME/.local/share/intel-arrow-lake-npu-tools"
  else
    printf '%s' "$HOME/.local/share/intel-npu-tools"
  fi
}

DATA_DIR="$(default_data_dir)"
VENV="$DATA_DIR/venv"
WITH_RERANKER=false
WITH_WHISPER_SMALL=false
WITH_MCP=true

usage() {
  cat <<'EOF'
Usage: intel-npu-tools-setup [options]

Creates the per-user Python environment and downloads the models.

  --with-reranker        also fetch the cross-encoder used by --rerank (~300 MB)
  --with-whisper-small   also fetch the noise-robust speech model (~250 MB)
  --without-mcp          skip registering the MCP server with AI agent clients
  -h, --help             show this message
EOF
}

for argument in "$@"; do
  case "$argument" in
    --with-reranker) WITH_RERANKER=true ;;
    --with-whisper-small) WITH_WHISPER_SMALL=true ;;
    --without-mcp) WITH_MCP=false ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $argument" >&2; usage >&2; exit 2 ;;
  esac
done

if [[ $EUID -eq 0 ]]; then
  echo "Run this as your own user, not as root: it builds an environment in your home directory." >&2
  exit 1
fi

if [[ ! -d "$LIBDIR" ]]; then
  echo "The toolkit's files are not at $LIBDIR. Is the package installed?" >&2
  exit 1
fi

# python3 is not necessarily new enough. Enterprise Linux 9 ships 3.9 as
# python3 and carries newer interpreters beside it under their own names, so
# taking python3 on faith there builds an environment that cannot run this at
# all. Newest first, and python3 last so it wins on a distribution where it is
# already the newest thing present.
# Being new enough is not sufficient: Debian and its derivatives ship the venv
# machinery separately, so an interpreter can be present and modern and still
# unable to build an environment. Taking the newest one on version alone would
# pick python3.13 with no python3.13-venv over a perfectly good python3.11 and
# then fail. Both are checked, and a candidate that cannot do the job is
# passed over rather than fatal.
find_python() {
  local candidate
  for candidate in python3.14 python3.13 python3.12 python3.11 python3.10 python3; do
    command -v "$candidate" >/dev/null || continue
    if "$candidate" -c '
import sys
if sys.version_info < (3, 10):
    raise SystemExit(1)
import venv, ensurepip          # noqa: F401 — presence is the whole test
' 2>/dev/null; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

if ! PYTHON="$(find_python)"; then
  echo "No Python 3.10 or newer that can create a virtual environment was found." >&2
  echo "Install one and run this again:" >&2
  echo "    Enterprise Linux 9:  sudo dnf install python3.12 python3.12-pip" >&2
  echo "    Debian and Ubuntu:   sudo apt install python3-venv" >&2
  exit 1
fi

echo "Creating the Python environment in $VENV, using $PYTHON…"
mkdir -p "$DATA_DIR"
"$PYTHON" -m venv "$VENV"
"$VENV/bin/python" -m pip install --upgrade --quiet pip
# Installed from the copy the package shipped, so this never reaches the
# network for the toolkit itself — only for its published dependencies.
"$VENV/bin/python" -m pip install --quiet "$LIBDIR"

DOWNLOAD_ARGUMENTS=()
$WITH_RERANKER && DOWNLOAD_ARGUMENTS+=(--with-reranker)
$WITH_WHISPER_SMALL && DOWNLOAD_ARGUMENTS+=(--with-whisper-small)
echo "Downloading models (about 800 MB on a first run)…"
INTEL_NPU_TOOLS_HOME="$DATA_DIR" "$VENV/bin/python" "$LIBDIR/scripts/download-models.py" \
  ${DOWNLOAD_ARGUMENTS[@]+"${DOWNLOAD_ARGUMENTS[@]}"}

MCP_FAILURES=()
if $WITH_MCP; then
  MCP_COMMAND="/usr/bin/intel-npu-mcp"
  # Each failure used to be discarded, and setup then announced itself
  # complete — so a registration that did not happen looked exactly like one
  # that did, and the tools simply never appeared in the agent. It is still
  # not fatal, because everything else works without it, but it is said out
  # loud at the end.
  if command -v codex >/dev/null && ! codex mcp get intel-npu-tools >/dev/null 2>&1; then
    codex mcp add intel-npu-tools -- "$MCP_COMMAND" || MCP_FAILURES+=("codex")
  fi
  if command -v claude >/dev/null && ! claude mcp get intel-npu-tools >/dev/null 2>&1; then
    claude mcp add --scope user --transport stdio intel-npu-tools -- "$MCP_COMMAND" \
      || MCP_FAILURES+=("claude")
  fi
  if command -v gemini >/dev/null && ! gemini mcp list 2>/dev/null | grep -q intel-npu-tools; then
    gemini mcp add --scope user intel-npu-tools "$MCP_COMMAND" || MCP_FAILURES+=("gemini")
  fi
fi

echo
"$VENV/bin/intel-npu-info" || true

if [ ${#MCP_FAILURES[@]} -gt 0 ]; then
  cat >&2 <<EOF

Could not register the MCP server with: ${MCP_FAILURES[*]}
Everything else is set up. To retry one by hand, and see why it failed:

    claude mcp add --scope user --transport stdio intel-npu-tools -- $MCP_COMMAND
EOF
fi

cat <<EOF

Setup complete. Launch "Intel NPU Control Panel" from the desktop menu, or run
intel-npu-panel. If the NPU is not listed above, install Intel's driver and log
out and back in; see /usr/share/doc/intel-npu-tools/README.md.
EOF
